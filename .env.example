# ENES Properties — placeholders only. Never put real credentials in this file.
# Leave blank until the real approved application origin is configured.
NEXT_PUBLIC_APP_URL=

# PostgreSQL / Prisma 7. Use a direct connection for migrations; runtime uses Hyperdrive.
DATABASE_URL=
DIRECT_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
ENES_OWNER_CLERK_ID=

# Cloudflare R2 — pending uploads and approved public media must be separate buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=

# Rate-limit pseudonymous identifier hashing. Use a dedicated random secret.
RATE_LIMIT_HASH_SECRET=

# Ably real-time chat
ABLY_API_KEY=

# Resend transactional email. Sender must be verified with the provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENES_ADMIN_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mapbox maps and location search (optional until map features are enabled)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SECRET_TOKEN=

# Sentry monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
