{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enesproperties",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9846395fe5794b9882a6bd02661c4aae"
    }
  ]
}
